# Worker image: the Go bridge plus the real Pi coding agent and a baked-in LiteLLM
# (OpenAI-compatible) provider extension. The controller manager image stays separate.
#
# Build the bridge binary on the host first (so this image never pulls golang):
#   make build-bridge
# or  CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o bin/bridge ./cmd/bridge

# Runtime: Node + Pi + tools. Node >= 22.19.0 is required by pi-coding-agent.
FROM node:22-bookworm-slim

# Pi (@earendil-works/pi-coding-agent) requires on PATH: git, bash, node. bash and node
# ship in the base; git, ripgrep and ca-certificates are installed here. rg and fd are
# auto-downloaded by Pi at runtime if missing, but ripgrep is pre-installed to avoid
# runtime GitHub egress. ca-certificates is needed for git clone, npm and LiteLLM HTTPS.
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Use the npmmirror.com registry; the default registry.npmjs.org is unreachable here.
RUN npm config set registry https://registry.npmmirror.com

RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@0.85.1

RUN groupadd -g 10001 pi && useradd -m -d /home/pi -u 10001 -g 10001 pi

COPY bin/bridge /usr/local/bin/bridge

# Bake the LiteLLM provider extension under /opt so it survives the runtime
# emptyDir mounted at /home/pi. The bridge symlinks it into the writable Pi
# agent dir (<home>/.pi/agent/extensions/litellm) at startup.
COPY internal/bridge/pi-extension/litellm /opt/pi-extensions/litellm
RUN cd /opt/pi-extensions/litellm && npm install --ignore-scripts \
  && chown -R pi:pi /opt/pi-extensions

RUN mkdir -p /workspace /tmp && chown -R pi:pi /workspace

USER pi
WORKDIR /workspace
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/bridge"]
